# ---- Web search engines (run in parallel; any engine left blank is skipped) ----
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# ---- LLM provider (any OpenAI-compatible Chat Completions endpoint) ----
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=

# Agent 1 - Information Agent
INFO_AGENT_MODEL=openai/gpt-oss-120b
# Agent 2 - Analysis Agent
ANALYSIS_AGENT_MODEL=qwen/qwen3.8-27b

# Optional: give each agent its own provider. Leave blank to reuse LLM_BASE_URL / LLM_API_KEY.
INFO_AGENT_BASE_URL=
INFO_AGENT_API_KEY=
ANALYSIS_AGENT_BASE_URL=
ANALYSIS_AGENT_API_KEY=

# ---- Search tuning ----
# Results requested from each engine per search query
RESULTS_PER_ENGINE=5
# Search results (after removing social media and duplicates) the Info Agent chooses from
SEARCH_CANDIDATES=20
# Sources the Info Agent chooses (primary and official first) and uses for the answer
SEARCH_MAX_RESULTS=10
# Characters of text kept per source
SOURCE_MAX_CHARS=1200
# An engine slower than this (milliseconds) is skipped for that question
SEARCH_TIMEOUT_MS=10000

# ---- Server ----
PORT=8787
# Questions allowed per visitor IP per hour
RATE_LIMIT_PER_HOUR=10
# Set to true to run without any API keys (canned search + canned agent output) for UI testing
MOCK_MODE=false
# Set to true to include the internal agent trace (APPROVED / CORRECTION_REQUIRED etc.) in API responses.
# Keep false for real users: the plan says rule compliance details must not be shown to users.
EXPOSE_TRACE=false
