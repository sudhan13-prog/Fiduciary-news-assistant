# ---- Web search (required for live mode) ----
TAVILY_API_KEY=

# ---- LLM provider (any OpenAI-compatible Chat Completions endpoint) ----
# Default points at OpenRouter, which hosts both gpt-oss and Qwen models.
# Other options: Groq (https://api.groq.com/openai/v1), Together (https://api.together.xyz/v1),
# a local vLLM / Ollama server (http://localhost:11434/v1), etc.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

# Agent 1 - Information Agent
INFO_AGENT_MODEL=openai/gpt-oss-20b
# Agent 2 - Analysis Agent (set to the exact Qwen model ID your provider exposes)
ANALYSIS_AGENT_MODEL=qwen/qwen3-32b

# Optional: give each agent its own provider. Leave blank to reuse LLM_BASE_URL / LLM_API_KEY.
INFO_AGENT_BASE_URL=
INFO_AGENT_API_KEY=
ANALYSIS_AGENT_BASE_URL=
ANALYSIS_AGENT_API_KEY=

# ---- Server ----
PORT=8787
# Max search results passed from Tavily to the Info Agent
SEARCH_MAX_RESULTS=6
# Set to true to run without any API keys (canned search + canned agent output) for UI testing
MOCK_MODE=false
# Set to true to include the internal agent trace (APPROVED / CORRECTION_REQUIRED etc.) in API responses.
# Keep false for real users: the plan says rule compliance details must not be shown to users.
EXPOSE_TRACE=false
